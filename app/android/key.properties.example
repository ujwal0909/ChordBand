# Example Android Keystore configuration for ChordBand production release
# Copy this file to `android/key.properties` and populate with your credentials.
# DO NOT commit `key.properties` or `.jks` files to version control.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=chordband
storeFile=/path/to/chordband-upload-key.jks
